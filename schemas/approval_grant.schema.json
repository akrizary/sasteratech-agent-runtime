{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalGrant",
  "type": "object",
  "required": [
    "approval_id",
    "risk_ceiling",
    "actions",
    "resource_scope",
    "issued_by"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "risk_ceiling": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resource_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "nonce": {
      "type": [
        "string",
        "null"
      ]
    },
    "issued_by": {
      "enum": [
        "human",
        "policy"
      ]
    }
  },
  "additionalProperties": false
}