{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SasteraTechSkill",
  "type": "object",
  "required": [
    "id",
    "version",
    "purpose",
    "positive_triggers",
    "negative_triggers",
    "risk_ceiling",
    "workflow"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "positive_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_ceiling": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}